{
  "name": "filelynx",
  "version": "0.1.0",
  "description": "Lightweight web file browser, editor, terminal, notebooks, FTP and S3 client for your VPS.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.ts",
  "types": "src/server.ts",
  "files": [
    "src",
    "frontend",
    "public",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "filebrowser",
    "file-manager",
    "editor",
    "codemirror",
    "terminal",
    "xterm",
    "notebooks",
    "ftp",
    "s3",
    "vps",
    "self-hosted",
    "web-ide",
    "nodejs",
    "typescript",
    "express"
  ],
  "author": "Ryuzei-Ts",
  "license": "Apache-2.0",
  "repository": "https://github.com/Ryuzei-Ts/FileLynx",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml,css,html}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml,css,html}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "imports": {
    "#config": "./src/config/index.ts",
    "#db": "./src/db/index.ts",
    "#db/schema": "./src/db/schema.ts",
    "#app": "./src/app.ts",
    "#types": "./src/types/index.ts",
    "#routes/*": "./src/routes/*.ts",
    "#services/*": "./src/services/*.service.ts",
    "#utils/*": "./src/utils/*.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.600.0",
    "@aws-sdk/s3-request-presigner": "^3.600.0",
    "basic-ftp": "^5.0.5",
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "multer": "^1.4.5-lts.1",
    "node-pty": "^1.0.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "@vitest/coverage-v8": "^2.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
